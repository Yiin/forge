{
  "name": "forge",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "trustedDependencies": [
    "node-pty"
  ],
  "scripts": {
    "lint": "oxlint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "e2e/node_modules/.bin/playwright test -c e2e/playwright.config.ts",
    "build": "cd apps/web && bunx vite build",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
