{
  "name": "forge",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "trustedDependencies": [
    "node-pty"
  ],
  "scripts": {
    "build:cursor-sidecar": "bun scripts/build-cursor-sidecar.ts",
    "package:release": "node scripts/package-release.mjs",
    "smoke:packed-native": "node scripts/packed-native-smoke.mjs",
    "postinstall": "node scripts/install-native.mjs",
    "native:build": "node scripts/build-node-pty.mjs",
    "native:check": "node scripts/check-node-pty.mjs",
    "lint": "oxlint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "node e2e/scripts/run-e2e.mjs",
    "build": "cd apps/web && bunx vite build",
    "build:kimi-guardian": "bun build --target=node apps/server/src/harnesses/kimi/guardian.ts --outfile dist/kimi-guardian.js",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "node-gyp": "11.4.2",
    "@types/node": "^24.0.0",
    "oxlint": "^1.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "patchedDependencies": {
    "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
  }
}
