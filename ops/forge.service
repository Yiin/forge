[Unit]
Description=Forge personal agent workspace
After=network-online.target

[Service]
ExecStart=%h/.local/bin/forge
Restart=on-failure
RestartSec=3
Environment=FORGE_PORT=3900
Environment=FORGE_DATA_DIR=%h/.local/share/forge
# PATH comes from the systemd user manager. If a host's harness CLIs are not
# on that PATH, set it in ~/.config/systemd/user/forge.service.d/path.conf.
# install.sh never touches that drop-in directory.

[Install]
WantedBy=default.target
