[Unit]
Description=Forge personal agent workspace
After=network-online.target

[Service]
ExecStart=%h/.local/bin/forge
Restart=on-failure
RestartSec=3
Environment=FORGE_PORT=3900
Environment=FORGE_DATA_DIR=%h/.local/share/forge
Environment=PATH=%h/.vite-plus/js_runtime/node/24.20.0/bin:%h/.local/bin:%h/.local/share/mise/shims:%h/.vite-plus/bin:%h/.kimi-code/bin:%h/.opencode/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
