#!/usr/bin/env bash
set -euo pipefail
repo="${FORGE_REPO:-Yiin/forge}"
bin="${FORGE_BIN:-$HOME/.local/bin/forge}"
state_dir="${FORGE_STATE_DIR:-$HOME/.local/state/forge}"
installed_file="$state_dir/installed-version"
port="${FORGE_PORT:-3900}"
health_url="${FORGE_HEALTH_URL:-http://127.0.0.1:${port}/api/health}"
status_url="${FORGE_STATUS_URL:-http://127.0.0.1:${port}/api/status}"
work_dir="${FORGE_UPDATE_DIR:-$state_dir/update}"
health_attempts="${FORGE_HEALTH_ATTEMPTS:-60}"
health_sleep="${FORGE_HEALTH_SLEEP:-1}"
mkdir -p "$state_dir"
release_json="$(gh release view --repo "$repo" --json tagName,assets)"
latest="$(printf '%s' "$release_json" | jq -r '.tagName')"
[[ -n "$latest" && "$latest" != null ]] || { echo 'forge-update: release has no tag' >&2; exit 1; }
status="$(curl -fsS --max-time 5 "$status_url" 2>/dev/null || true)"
running="$(printf '%s' "$status" | jq -r '.epicRuns.running // 0' 2>/dev/null || echo 0)"
if [[ "$running" =~ ^[0-9]+$ && "$running" -gt 0 ]]; then
  echo "forge-update: epic run active ($running), skipping update; retrying next timer tick"
  exit 0
fi
current="$(curl -fsS --max-time 5 "$health_url" 2>/dev/null | jq -r '.version // empty' 2>/dev/null || true)"
[[ -n "$current" ]] || current="$(cat "$installed_file" 2>/dev/null || true)"
if [[ "$latest" == "$current" ]]; then
  echo "forge-update: already running $current"
  exit 0
fi
asset="$(printf '%s' "$release_json" | jq -r '.assets[].name | select(test("forge-linux-x64\\.tar\\.gz$"))' | head -n1)"
[[ -n "$asset" ]] || asset="$(printf '%s' "$release_json" | jq -r '.assets[].name | select(test("forge$"))' | head -n1)"
[[ -n "$asset" ]] || { echo 'forge-update: release has no forge asset' >&2; exit 1; }
rm -rf "$work_dir"
mkdir -p "$work_dir"
gh release download "$latest" --repo "$repo" --pattern "$asset" --dir "$work_dir"
gh release download "$latest" --repo "$repo" --pattern checksums.txt --dir "$work_dir"
(
  cd "$work_dir"
  expected="$(awk -v name="$asset" '$2 == name || $2 == "*" name { print $1; exit }' checksums.txt)"
  [[ -n "$expected" ]] || { echo "forge-update: no checksum for $asset" >&2; exit 1; }
  actual="$(sha256sum "$asset" | awk '{print $1}')"
  [[ "$actual" == "$expected" ]] || { echo 'forge-update: checksum mismatch' >&2; exit 1; }
)
new="$bin.new"
prev="$bin.prev"
if [[ "$asset" == *.tar.gz ]]; then
  tar -xzf "$work_dir/$asset" -C "$work_dir"
  source="$(find "$work_dir" -type f \( -path '*/apps/server/src/index.js' -o -name forge \) -print -quit)"
else
  source="$work_dir/$asset"
fi
[[ -n "${source:-}" && -f "$source" ]] || { echo 'forge-update: archive has no server binary' >&2; exit 1; }
cp "$source" "$new"
chmod 755 "$new"
[[ ! -f "$bin" ]] || cp "$bin" "$prev"
mv -f "$new" "$bin"
systemctl --user restart forge.service
healthy=0
for _ in $(seq 1 "$health_attempts"); do
  if curl -fsS --max-time 2 "$health_url" | jq -e --arg version "$latest" '.ok == true and (.version == $version or (.version | startswith($version + "-")))' >/dev/null 2>&1; then
    healthy=1
    break
  fi
  sleep "$health_sleep"
done
if [[ "$healthy" != 1 ]]; then
  echo 'forge-update: health failed, restoring previous version' >&2
  [[ -f "$prev" ]] || exit 1
  cp -f "$prev" "$bin"
  systemctl --user restart forge.service || true
  exit 1
fi
printf '%s\n' "$latest" > "$installed_file"
echo "forge-update: installed $latest"
